# ==============================================================================
# FLOWRA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file as .env for local development.
# On Render: Set these variables in Dashboard -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8080
SPRING_APPLICATION_NAME=flowra-backend

# ------------------------------------------------------------------------------
# 2. MYSQL DATABASE CONFIGURATION (Railway MySQL TCP Proxy)
# ------------------------------------------------------------------------------
# IMPORTANT FOR RENDER DEPLOYMENT:
# Format MUST start with 'jdbc:mysql://' and use Railway's public TCP Proxy host & port.
# Example: jdbc:mysql://junction.proxy.rlwy.net:12345/railway?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
# DO NOT use 'mysql.railway.internal' when connecting from Render.
DB_URL=jdbc:mysql://localhost:3306/flowra_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DB_DRIVER=com.mysql.cj.jdbc.Driver

# ------------------------------------------------------------------------------
# 3. JPA / HIBERNATE ORM CONFIGURATION
# ------------------------------------------------------------------------------
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY CREDENTIALS (Server-Side Only)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME=FLOWRA Artisanal Florist

# ------------------------------------------------------------------------------
# 5. SECURITY & CORS CONFIGURATION
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. MULTIPART FILE UPLOAD LIMITS
# ------------------------------------------------------------------------------
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# ------------------------------------------------------------------------------
# 7. LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_HIBERNATE=WARN
